import os
from PIL import Image
from torchvision.transforms import transforms
from dataset_functions import cut_one_tile, poisson, row, read, quantization
#wrote a code for saving the tiles right now but when i will write the training code, i will use the tensor for the tiles without saving them to folders. 
Input_images=r"D:\Users\Parth\AstroVision\Dataset\Input_images"
tiles_target="D:\Users\Parth\AstroVision\Dataset\tiles\tiles_target"
tiles_noisy="D:\Users\Parth\AstroVision\Dataset\tiles\tiles_noisy"
counter=0
for filename in os.listdir(Input_images):
    counter+=1
    path_in=os.path.join(Input_images, filename)
    im=Image.open(path_in)
    input_image=cut_one_tile(im)
    out_name=f"tile{counter:03d}.png"
    tile1=os.path.join(tiles_target, out_name)
    input_image.save(tile1)
    
    transformation1=transforms.ToTensor()
    image0=transformation1(input_image)
    image1=poisson(image0)
    image2=row(image1)
    image3=read(image2)
    image4=quantization(image3)
    transformation2=transforms.ToPILImage()
    im_back=transformation2(image4)
    tile2=os.path.join(tiles_noisy, out_name)
    im_back.save(tile2)
