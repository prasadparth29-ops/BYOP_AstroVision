def get_quad_hash(quad_pts):
    dist_matrix = np.linalg.norm(quad_pts[:, None] - quad_pts, axis=2)
    i, j = np.unravel_index(np.argmax(dist_matrix), dist_matrix.shape)
    
    A, B = quad_pts[i], quad_pts[j]
    others = np.delete(quad_pts, [i, j], axis=0)
    C, D = others[0], others[1]

    vec_AB = B - A
    L2 = np.dot(vec_AB, vec_AB)
    
    def transform(P):
        vec_AP = P - A
        x = np.dot(vec_AP, vec_AB) / L2
        y = np.dot(vec_AP, np.array([-vec_AB[1], vec_AB[0]])) / L2
        return x, y

    xc, yc = transform(C)
    xd, yd = transform(D)
    
    if xc > xd:
        xc, xd = xd, xc
        yc, yd = yd, yc
        
    return (xc, yc, xd, yd)

