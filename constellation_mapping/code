def adaptive_thresholding(input):
    thresh= th3 = cv2.adaptiveThreshold(input,255,cv2.ADAPTIVE_THRESH_GAUSSIAN_C,cv2.THRESH_BINARY,51,-3)
    return thresh

#
def LoG(input_image, sigma):
    log=ndimage.gaussian_laplace(input_image, sigma=sigma)
    return log

